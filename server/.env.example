# Copy to .env for local runs. Everything here has a working default except
# JWT_SECRET, which is mandatory in production.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# SQLite file. Point it at a persistent volume in production.
DB_FILE=./data/ai4food.db

# openssl rand -hex 32
JWT_SECRET=
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000

# Login codes. OTP_ECHO returns the code in the API response so you can test
# without an SMS gateway; the server refuses to boot with it on in production.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_ECHO=true

# Comma separated, or * for any origin.
CORS_ORIGINS=*

# Marketplace rules
COMMISSION_BPS=1500
CANCEL_WINDOW_MINUTES=120
PICKUP_GRACE_MINUTES=60
CO2_PER_MEAL_KG=1.2

# ---------------------------------------------------------------------------
# Sign-in codes go out over a real gateway. "console" prints them to the log
# and is development only — production refuses to boot on it, because a code
# nobody receives means nobody can sign in.
#   console | orange | twilio | http
SMS_PROVIDER=console
SMS_SENDER_NAME=AI4Food

# Orange Senegal SMS API
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER_ADDRESS=          # the MSISDN Orange issued you, +221…

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Any other gateway: {{to}} and {{text}} are substituted in url, headers, body.
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_CONTENT_TYPE=application/json
SMS_HTTP_HEADERS=               # "Authorization: Bearer xyz", one per line or ;-separated
SMS_HTTP_BODY={"to":"{{to}}","message":"{{text}}"}

# ---------------------------------------------------------------------------
# Payments. Cash always works and needs nothing. A wallet appears in the app
# only once its credentials are here, so nothing on screen can offer a way to
# pay that does not exist.
#
# How long a customer has to finish paying before the bag goes back on sale.
PAYMENT_WINDOW_MINUTES=15
# Where wallets send the customer back to, and where they call us.
PUBLIC_APP_URL=http://localhost:8080/ai4food-app.html
PUBLIC_API_URL=http://localhost:4000

# Wave (Senegal)
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_BASE_URL=https://api.wave.com

# Orange Money (Senegal web payment). OM_CURRENCY is OUV in sandbox, XOF live.
OM_CLIENT_ID=
OM_CLIENT_SECRET=
OM_MERCHANT_KEY=
OM_CURRENCY=OUV
OM_BASE_URL=https://api.orange.com/orange-money-webpay/sen/v1

# A wallet that settles itself, for walking through the flow locally.
# Ignored in production.
PAYMENTS_SANDBOX=false
